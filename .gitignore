# Archives
*.rar
*.zip
*.7z

# Deployed/runnable server (built binaries + live data, not source)
MuServer/
# ...except the Lua scripts themselves - hand-written source, not build output
!MuServer/
MuServer/*
!MuServer/Data/
MuServer/Data/*
!MuServer/Data/Script/
!MuServer/Data/Script/**

# Global Release client build (1GB+, never tracked/pushed - only Global Debug is)
Source_Client/Global Release/

# SQL Server database files (data + transaction log)
*.mdf
*.ldf

# Build intermediates only (kept Global Debug/Global Release themselves - runnable client + assets)
Source_Client/tmp/
Source_Client/source/Global Debug/
Source_Client/source/Global Release/

# Runtime debug log, rewritten every client launch - not source
PacketList.txt

# Build outputs (server, per-sub-project Debug/Release dirs)
Source_Server/**/Debug/
Source_Server/**/Release/
Source_Server/**/bin/
Source_Server/**/obj/

# Vendored third-party source (large, not ours)
Source_Server/ConnectServer/Dependences/curl-master/

# Generic build/intermediate artifacts anywhere
*.obj
*.pdb
*.ipdb
*.iobj
*.sbr
*.idb
*.ilk
*.exp
*.lib
!Source_Server/GameServer/GameServer/Util/lua/lua52.lib
!Source_Client/dependencies/lib/lua52.lib
*.exe
*.res
*.tlog
*.log
*.ncb
*.aps
*.sdf
*.opensdf
*.suo
*.VC.db
*.VC.VC.opendb

# Editor/OS cruft
.vs/
Thumbs.db
